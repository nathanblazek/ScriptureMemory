<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ScriptureMemory.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ScriptureMemory"
    xmlns:models="using:ScriptureMemory.Models"
    Title="Scripture Memory">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===== Sidebar: collections ===== -->
        <Grid Padding="16,20,16,16" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="Collections" Style="{StaticResource SubtitleTextBlockStyle}" />

            <Grid Grid.Row="1" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="NewCollectionBox" PlaceholderText="New collection name" KeyDown="NewCollectionBox_KeyDown" />
                <Button Grid.Column="1" Click="AddCollection_Click" ToolTipService.ToolTip="Create collection"
                        Style="{StaticResource AccentButtonStyle}">
                    <SymbolIcon Symbol="Add" />
                </Button>
            </Grid>

            <ListView x:Name="CollectionsList" Grid.Row="2" SelectionMode="Single" SelectionChanged="CollectionsList_SelectionChanged">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:VerseCollection">
                        <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" Padding="0,8" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <StackPanel Grid.Row="3" Spacing="8">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="RenameButton" Click="RenameCollection_Click" HorizontalAlignment="Stretch" IsEnabled="False">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <SymbolIcon Symbol="Rename" />
                            <TextBlock Text="Rename" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="DeleteButton" Grid.Column="1" Click="DeleteCollection_Click" HorizontalAlignment="Stretch" IsEnabled="False">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <SymbolIcon Symbol="Delete" />
                            <TextBlock Text="Delete" />
                        </StackPanel>
                    </Button>
                </Grid>
                <Button Click="TrainVoice_Click" HorizontalAlignment="Stretch"
                        ToolTipService.ToolTip="Read a few sentences aloud so Windows learns your voice. Improves recognition when you recite.">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE720;" FontSize="16" />
                        <TextBlock Text="Train my voice" />
                    </StackPanel>
                </Button>
                <Button Click="Settings_Click" HorizontalAlignment="Stretch">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <SymbolIcon Symbol="Setting" />
                        <TextBlock Text="ESV API key" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ===== Content ===== -->
        <Grid Grid.Column="1"
              Background="{ThemeResource LayerFillColorDefaultBrush}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
              BorderThickness="1,1,0,0" CornerRadius="8,0,0,0">

            <!-- Empty state -->
            <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8" MaxWidth="420">
                <FontIcon Glyph="&#xE82D;" FontSize="48" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="Create a collection to get started" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
                <TextBlock TextWrapping="Wrap" TextAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="Collections group the passages you're memorizing, e.g. “Romans Road” or “Psalm 119”. Type a name on the left and press +." />
            </StackPanel>

            <!-- Collection detail -->
            <Grid x:Name="CollectionPanel" Padding="32,24,32,16" RowSpacing="16" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock x:Name="CollectionTitle" Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock x:Name="CollectionSummary" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <!-- Add verses card -->
                <Border Grid.Row="1" Padding="16" CornerRadius="8"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Add verses" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ComboBox x:Name="BookBox" Header="Book" Width="190" SelectionChanged="BookBox_SelectionChanged" />
                            <NumberBox x:Name="ChapterBox" Header="Chapter" Width="100" Minimum="1" Value="1"
                                       SpinButtonPlacementMode="Compact" />
                            <NumberBox x:Name="FromVerseBox" Header="From verse" Width="110" Minimum="1"
                                       SpinButtonPlacementMode="Compact" PlaceholderText="all" />
                            <NumberBox x:Name="ToVerseBox" Header="To verse" Width="110" Minimum="1"
                                       SpinButtonPlacementMode="Compact" PlaceholderText="—" />
                            <Button x:Name="AddPickerButton" Content="Add" Click="AddFromPicker_Click"
                                    Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Bottom" />
                        </StackPanel>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MaxWidth="518" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="ReferenceBox" Header="…or type any reference (spans chapters too)"
                                     PlaceholderText="e.g. Romans 8:28-39, Psalm 23, John 3:16-4:2" KeyDown="ReferenceBox_KeyDown" />
                            <Button x:Name="AddReferenceButton" Grid.Column="1" Content="Add" Click="AddFromReference_Click" VerticalAlignment="Bottom" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="8" x:Name="BusyPanel" Visibility="Collapsed">
                            <ProgressRing IsActive="True" Width="16" Height="16" />
                            <TextBlock Text="Fetching from the ESV API…" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <InfoBar x:Name="StatusBar" Grid.Row="2" IsOpen="False" />

                <ListView x:Name="PassagesList" Grid.Row="3" SelectionMode="None" IsItemClickEnabled="True" ItemClick="PassagesList_ItemClick">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="12,4" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:Passage">
                            <Grid Padding="0,10" ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{x:Bind Reference}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="{x:Bind Preview}" TextWrapping="Wrap" MaxLines="2" TextTrimming="WordEllipsis"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{x:Bind Status}" Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <CheckBox Content="Mastered" IsChecked="{x:Bind Mastered}" Click="Mastered_Click" MinWidth="0" />
                                    <Button Content="Practice" Click="Practice_Click" Style="{StaticResource AccentButtonStyle}" />
                                    <Button Click="DeletePassage_Click" ToolTipService.ToolTip="Remove from collection">
                                        <SymbolIcon Symbol="Delete" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <!-- Practice -->
            <local:PracticeView x:Name="PracticePanel" Visibility="Collapsed" />
        </Grid>
    </Grid>
</Window>
